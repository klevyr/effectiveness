# Variables de entorno requeridas para efectividad
# Copia este archivo como .env y completa los valores

# SFTP - Conexión al servidor del proveedor
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_UID=usuario
SFTP_PWD=contraseña

# AS400 - Conexión al sistema de transferencias
AS400_USER=usuario_as400
AS400_PASS=contraseña_as400
